{
  "name": "klubbstugan",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash scripts/e2e-local.sh",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "content": "tsx scripts/content.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fflate": "^0.8.3",
    "nuxt": "^4.6.4",
    "pg": "^8.23.1",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
