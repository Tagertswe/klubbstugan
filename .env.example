# Copy to .env.local (or export in your shell) for local development.
# Postgres from `docker compose up -d db` listens on 127.0.0.1:5433.
DATABASE_URL=postgresql://klubbstugan:klubbstugan@localhost:5433/klubbstugan
DB_PASSWORD=klubbstugan

NUXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" shows the theme switch in the footer and accepts ?tema=… (demo only).
NUXT_PUBLIC_THEME_SWITCH=true
# Site default when nobody has chosen a theme: klassisk | fart | klubbdrakt
NUXT_DEFAULT_THEME=klassisk
# Where content-pack images are stored and served from (/app/uploads in Docker).
NUXT_UPLOADS_DIR=./uploads

# Later phases (login, e-mail, push):
# NUXT_SESSION_PASSWORD=          # at least 32 chars
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD=
# MAIL_FROM="Team Blekinge LF <noreply@teamblekinge.nu>"
# WEBAUTHN_RP_ID=localhost        # klubbstugan.appzma.com for the demo
# CRON_SECRET=
